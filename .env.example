# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so your keys never reach GitHub.
# Restart `npm run dev` after editing it.

# MailerLite API token (MailerLite > Integrations > Developer API)
NEXT_PUBLIC_NewsletterToken=

# MailerLite group that new subscribers are added to
NEXT_PUBLIC_GroupId=

# Optional: secret word for the /blog page (defaults to "melon" if unset)
# NEWSLETTER_SECRET_WORD=melon
