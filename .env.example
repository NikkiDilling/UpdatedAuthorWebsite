# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so your keys never reach GitHub.
# Restart `npm run dev` after editing it.

# MailerLite API token: a very long string starting with "eyJ"
# (MailerLite > Integrations > Developer API)
NEXT_PUBLIC_NewsletterToken=

# MailerLite group ID: a short NUMBER (about 18 digits), NOT the API token.
# New subscribers are added to this group, and /blog only lists campaigns sent to it.
NEXT_PUBLIC_GroupId=

# Optional: secret word for the /blog page (defaults to "melon" if unset)
# NEWSLETTER_SECRET_WORD=melon
